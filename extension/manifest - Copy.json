{
  "manifest_version": 3,
  "name": "Edge Screenshot Automation",
  "short_name": "Screenshot Automation",
  "version": "1.0.0",
  "description": "Opens your login page, waits for you to sign in (including MFA), then visits your URL list and saves screenshots locally. Controlled from your own GitHub Pages dashboard.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Edge Screenshot Automation",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://YOUR-GITHUB-USERNAME.github.io/edge-screenshot-automation/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'"
  }
}
